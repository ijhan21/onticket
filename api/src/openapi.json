{
  "openapi": "3.0.0",
  "info": {
    "title": "온티켓(OnTicket) API",
    "version": "1.0.0",
    "description": "(주)승승장구 온티켓 티켓 예매 및 운영 관리 시스템 API 명세"
  },
  "servers": [
    {
      "url": "http://localhost:8787",
      "description": "로컬 개발 서버"
    }
  ],
  "components": {
    "securitySchemes": {
      "AdminAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Admin-Password",
        "description": "운영팀 인증 헤더"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string", "example": "SOLD_OUT" },
              "message": { "type": "string", "example": "선택하신 좌석이 매진되었습니다." }
            },
            "required": ["code", "message"]
          }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "서버 상태 확인",
        "tags": ["시스템"],
        "responses": {
          "200": {
            "description": "정상",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "status": { "type": "string", "example": "ok" } }
                }
              }
            }
          }
        }
      }
    },
    "/events": {
      "get": {
        "summary": "판매 가능한 공연 목록 조회 (S01, R1, R24)",
        "tags": ["고객 서비스 - 공연"],
        "responses": {
          "200": {
            "description": "공연 목록 반환",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "events": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "event_id": { "type": "string", "example": "EV001" },
                          "title": { "type": "string", "example": "2026 유하늘 전국투어 콘서트 <파도> - 서울" },
                          "category": { "type": "string", "example": "콘서트" },
                          "venue": { "type": "string", "example": "올림픽공원 올림픽홀" },
                          "city": { "type": "string", "example": "서울" },
                          "start_at": { "type": "string", "example": "2026-09-26T10:00:00.000Z" },
                          "end_at": { "type": "string", "example": "2026-09-26T12:30:00.000Z" },
                          "sales_status": { "type": "string", "example": "판매중" },
                          "organizer": { "type": "string", "example": "(주)승승장구" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/events/{event_id}": {
      "get": {
        "summary": "공연 상세 정보 및 등급별 잔여석 조회 (S02, R1, R5, R6)",
        "tags": ["고객 서비스 - 공연"],
        "parameters": [
          {
            "name": "event_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "example": "EV001" },
            "description": "공연 식별자"
          }
        ],
        "responses": {
          "200": {
            "description": "공연 상세 및 권종별 잔여석",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "event_id": { "type": "string" },
                    "title": { "type": "string" },
                    "category": { "type": "string" },
                    "venue": { "type": "string" },
                    "city": { "type": "string" },
                    "start_at": { "type": "string" },
                    "end_at": { "type": "string" },
                    "sales_status": { "type": "string" },
                    "organizer": { "type": "string" },
                    "ticket_types": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "ticket_type_id": { "type": "string", "example": "TT001" },
                          "grade": { "type": "string", "example": "VIP" },
                          "price": { "type": "integer", "example": 154000 },
                          "total_quantity": { "type": "integer", "example": 200 },
                          "sold_quantity": { "type": "integer", "example": 10 },
                          "remaining_quantity": { "type": "integer", "example": 190 }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "공연 없음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/orders": {
      "post": {
        "summary": "비회원 티켓 예매 주문 생성 (S02, R1, R6, R20, R22)",
        "tags": ["고객 서비스 - 주문"],
        "description": "주문 생성 시 결제대기 상태로 잡히며, 권종의 판매수량이 주문 수량만큼 원자적으로 증가합니다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["event_id", "ticket_type_id", "purchaser_email", "quantity"],
                "properties": {
                  "event_id": { "type": "string", "example": "EV001" },
                  "ticket_type_id": { "type": "string", "example": "TT001" },
                  "purchaser_email": { "type": "string", "format": "email", "example": "user@example.com" },
                  "purchaser_name": { "type": "string", "example": "홍길동" },
                  "quantity": { "type": "integer", "minimum": 1, "maximum": 4, "example": 2 }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "주문 생성 완료 (결제대기)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "order_id": { "type": "string", "example": "ORD-20261107-1001" },
                    "event_id": { "type": "string" },
                    "ticket_type_id": { "type": "string" },
                    "purchaser_email": { "type": "string" },
                    "quantity": { "type": "integer" },
                    "total_amount": { "type": "integer", "description": "서버 독점 계산 결제금액" },
                    "status": { "type": "string", "example": "결제대기" },
                    "ordered_at": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "입력 유효성 검증 실패 (수량 초과 등)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "404": {
            "description": "공연 또는 등급 없음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "409": {
            "description": "매진 또는 잔여 수량 부족",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      },
      "get": {
        "summary": "주문번호와 이메일로 비회원 티켓 조회 (S05, R7, R21, R22)",
        "tags": ["고객 서비스 - 주문"],
        "description": "다요소 식별 검증: order_id와 purchaser_email이 모두 일치해야만 조회가 허용됩니다.",
        "parameters": [
          {
            "name": "order_id",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "example": "ORD-20261011-0012" }
          },
          {
            "name": "purchaser_email",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "example": "user12@example.com" }
          }
        ],
        "responses": {
          "200": {
            "description": "티켓 정보 및 QR 코드 반환",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "order_id": { "type": "string" },
                    "event_title": { "type": "string" },
                    "venue": { "type": "string" },
                    "start_at": { "type": "string" },
                    "grade": { "type": "string" },
                    "quantity": { "type": "integer" },
                    "total_amount": { "type": "integer" },
                    "status": { "type": "string" },
                    "qr_code": { "type": "string" }
                  }
                }
              }
            }
          },
          "404": {
            "description": "일치하는 티켓 없음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/orders/{order_id}/payment": {
      "post": {
        "summary": "결제 승인 처리 및 QR 코드 발급 (S03, R5, R7, R22)",
        "tags": ["고객 서비스 - 주문"],
        "description": "서버 승인 성공 시 결제완료 상태로 전이되며 고유 QR 코드가 발급됩니다.",
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["total_amount"],
                "properties": {
                  "payment_key": { "type": "string" },
                  "payment_method": { "type": "string", "example": "신용카드" },
                  "total_amount": { "type": "integer", "example": 50000 }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "결제 승인 완료 및 QR 발급",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "order_id": { "type": "string" },
                    "status": { "type": "string", "example": "결제완료" },
                    "qr_code": { "type": "string", "example": "OT-1001-A1B2" },
                    "payment_key": { "type": "string" },
                    "total_amount": { "type": "integer" },
                    "updated_at": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/admin/events": {
      "get": {
        "summary": "운영팀 전체 공연 목록 및 통계 조회 (S07, R11, R23, R24)",
        "tags": ["운영자 서비스"],
        "security": [{ "AdminAuth": [] }],
        "responses": {
          "200": {
            "description": "공연 목록 및 총매출 집계",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "events": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "event_id": { "type": "string" },
                          "title": { "type": "string" },
                          "category": { "type": "string" },
                          "start_at": { "type": "string" },
                          "sales_status": { "type": "string" },
                          "total_quantity": { "type": "integer" },
                          "sold_quantity": { "type": "integer" },
                          "total_revenue": { "type": "integer", "description": "결제/입장완료 총 입금액" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "관리자 인증 필요",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      },
      "post": {
        "summary": "운영팀 신규 공연 및 권종 등록 (S08, R5, R23, R24)",
        "tags": ["운영자 서비스"],
        "security": [{ "AdminAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title", "category", "venue", "city", "start_at", "end_at", "ticket_types"],
                "properties": {
                  "title": { "type": "string", "example": "인디 밴드 라이브 2026" },
                  "category": { "type": "string", "example": "콘서트" },
                  "venue": { "type": "string", "example": "홍대 롤링홀" },
                  "city": { "type": "string", "example": "서울" },
                  "start_at": { "type": "string", "example": "2026-11-20T19:00:00Z" },
                  "end_at": { "type": "string", "example": "2026-11-20T21:30:00Z" },
                  "sales_status": { "type": "string", "enum": ["판매중", "매진", "판매종료"], "example": "판매중" },
                  "organizer": { "type": "string", "example": "(주)승승장구" },
                  "ticket_types": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 4,
                    "items": {
                      "type": "object",
                      "required": ["grade", "price", "total_quantity"],
                      "properties": {
                        "grade": { "type": "string", "example": "일반석" },
                        "price": { "type": "integer", "example": 44000 },
                        "total_quantity": { "type": "integer", "example": 150 }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "등록 성공" }
        }
      }
    },
    "/admin/events/{event_id}": {
      "put": {
        "summary": "운영팀 공연 정보 및 등급 수정 (S08, R5, R23, R24)",
        "tags": ["운영자 서비스"],
        "security": [{ "AdminAuth": [] }],
        "parameters": [
          {
            "name": "event_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title", "category", "venue", "city", "start_at", "end_at", "sales_status", "ticket_types"],
                "properties": {
                  "title": { "type": "string" },
                  "category": { "type": "string" },
                  "venue": { "type": "string" },
                  "city": { "type": "string" },
                  "start_at": { "type": "string" },
                  "end_at": { "type": "string" },
                  "sales_status": { "type": "string" },
                  "organizer": { "type": "string" },
                  "ticket_types": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "ticket_type_id": { "type": "string" },
                        "grade": { "type": "string" },
                        "price": { "type": "integer" },
                        "total_quantity": { "type": "integer" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "수정 성공" },
          "400": { "description": "판매수량 미만으로 총수량 축소 시도 등 오류" }
        }
      }
    },
    "/admin/checkins": {
      "post": {
        "summary": "현장 게이트 QR 스캔 입장 확인 및 기록 (S09, R9, R23)",
        "tags": ["운영자 서비스"],
        "security": [{ "AdminAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["qr_code", "gate"],
                "properties": {
                  "qr_code": { "type": "string", "example": "OT-0001-C7D8" },
                  "gate": { "type": "string", "example": "A게이트" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "입장 확인 완료",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "checkin_id": { "type": "string", "example": "CHK0016" },
                    "order_id": { "type": "string" },
                    "qr_code": { "type": "string" },
                    "gate": { "type": "string" },
                    "checked_in_at": { "type": "string" },
                    "result": { "type": "string", "example": "정상" }
                  }
                }
              }
            }
          },
          "404": { "description": "QR 코드 티켓 없음" },
          "409": { "description": "이미 입장 완료된 티켓 또는 미결제 티켓" }
        }
      }
    }
  }
}
